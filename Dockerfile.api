FROM python:3.11-slim

WORKDIR /app

# build-essential + libcurl for curl-cffi wheels that occasionally rebuild on slim images
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libcurl4-openssl-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps first so this layer caches across code changes
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# App code — src/ is imported by backend.main.create_mapping_from_url
COPY backend/ ./backend/
COPY src/ ./src/

# data/ is NOT copied — it's mounted from the host at runtime (see docker-compose.yml)

EXPOSE 8001

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8001"]
